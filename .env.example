# Application Settings
PROJECT_NAME="AI-Powered Intelligent Breed Recognition System"
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# PyTorch / CUDA Settings
CUDA_VISIBLE_DEVICES=0
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# Database (PostgreSQL - Foundation for future phases)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=breed_rec_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/breed_rec_db

# MLflow Experiment Tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=breed-recognition-experiment
